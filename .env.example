# Roboflow account credentials and project identifiers. Never commit real values.
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=
ROBOFLOW_PROJECT=

# Convex deployment URL, for example https://deployment-name.convex.cloud.
# This is not the .convex.site HTTP Actions URL.
CONVEX_URL=

# Configure this only in the Convex deployment and in the Roboflow Workflow
# x-webhook-secret header. It is not needed by the Kaggle training kernel.
ROBOFLOW_WEBHOOK_SECRET=

# Optional defense-in-depth credential. If configured in Convex, add the same
# value as a private Kaggle secret so only authorized jobs can update run state.
# KAGGLE_RUN_SECRET=
