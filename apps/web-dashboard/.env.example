# Convex development configuration.
# Copy this file to .env.local, or let `npx convex dev` generate it after login.
#
# VITE_CONVEX_URL is the Convex client URL used by a future Phase 7B dashboard.
# VITE_CONVEX_SITE_URL is the HTTP actions URL.
CONVEX_DEPLOYMENT=dev:youthful-pigeon-735
VITE_CONVEX_URL=https://youthful-pigeon-735.ap-southeast-2.convex.cloud
VITE_CONVEX_SITE_URL=https://youthful-pigeon-735.ap-southeast-2.convex.site

# For an anonymous local deployment instead, set CONVEX_AGENT_MODE=anonymous
# before `npx convex dev`; the CLI will replace these values with localhost.

# Processor ingestion secrets are NOT Vite variables. Do not put them in this
# file and do not prefix them with VITE_. Set them on the Convex deployment:
#
#   npx convex env set PROCESSOR_SHARED_SECRET "<at-least-32-character-secret>"
#   npx convex env set PROCESSOR_DEVICE_ID "PROCESSOR-DEMO-001"   # optional
#   npx convex env set PROCESSOR_MAX_CLOCK_SKEW_SECONDS "300"     # optional
#   npx convex env set PROCESSOR_MAX_REQUEST_BYTES "262144"       # optional
