# Convex HTTP Actions endpoint. Phase 7A/7B ingestion functions are deployed.
CONVEX_SITE_URL=https://youthful-pigeon-735.ap-southeast-2.convex.site

# Registered, active processor device and its HMAC secret. Never commit the
# real secret or prefix it with VITE_.
PROCESSOR_DEVICE_ID=PROCESSOR-DEMO-001
PROCESSOR_SHARED_SECRET=

# Existing Convex camera and optional monitoring zone identifiers.
CAMERA_ID=CAM-001
MONITORING_ZONE_ID=ZONE-DEMO-001
# Must match the Convex zone. Format: normalized x:y points separated by ;
MONITORING_ZONE_POLYGON=0.1:0.1;0.9:0.1;0.9:0.9;0.1:0.9

# Explicitly authorized local file, webcam index (for example 0), or RTSP URL.
# Keep disabled for dashboard-only mock preview. Later use tapo_rtsp for C200C.
PROCESSOR_SOURCE_MODE=disabled
VIDEO_SOURCE=
VIDEO_SOURCE_AUTHORIZED=false

# Roboflow Serverless YOLO-World. The key must remain only on the processor.
ROBOFLOW_API_KEY=
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_MODEL_VERSION=v2-s
ROBOFLOW_CLOUD_UPLOAD_ACKNOWLEDGED=false
ROBOFLOW_CLASS_PROMPTS=person,backpack,handbag,suitcase,duffel bag,shopping bag,briefcase,bag,water bottle,coffee mug,cup,cardboard box,package,parcel

# Experimental, unvalidated settings. Tune only with authorized labeled video.
DETECTION_CONFIDENCE=0.25
SAMPLE_FPS=2
STATIONARY_SECONDS=30
UNATTENDED_SECONDS=60
ASSOCIATION_DISTANCE=0.18
MOVEMENT_THRESHOLD=0.015
BACKGROUND_WARMUP_SECONDS=10
TRACK_TTL_SECONDS=10
SUMMARY_INTERVAL_SECONDS=5
HEARTBEAT_INTERVAL_SECONDS=30

REQUEST_TIMEOUT_SECONDS=30
REQUEST_RETRIES=3
DISPLAY_PREVIEW=false

# Optional bounded run for a smoke test. Zero means process until end/stopped.
MAX_SAMPLED_FRAMES=10
CONTINUOUS_PROCESSING_ACKNOWLEDGED=false
OBJECT_TRACKING_ID_OFFSET=1000000000
